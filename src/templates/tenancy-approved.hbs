<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tenancy Application Approved</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f5;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="580" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">
          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#1a3c5e 0%,#2d6a9f 100%);padding:40px 48px;text-align:center;">
              <h1 style="margin:0;color:#ffffff;font-size:28px;font-weight:700;letter-spacing:-0.5px;">Frakensons Global</h1>
              <p style="margin:8px 0 0;color:rgba(255,255,255,0.75);font-size:13px;letter-spacing:1px;text-transform:uppercase;">Property Management</p>
            </td>
          </tr>
          <!-- Success banner -->
          <tr>
            <td style="background:linear-gradient(135deg,#f0fff4,#c6f6d5);padding:28px 48px;text-align:center;border-bottom:2px solid #9ae6b4;">
              <div style="font-size:48px;margin-bottom:8px;">🎉</div>
              <h2 style="margin:0;color:#276749;font-size:22px;font-weight:700;">Application Approved!</h2>
              <p style="margin:8px 0 0;color:#2f855a;font-size:15px;">Congratulations — your tenancy application has been accepted</p>
            </td>
          </tr>
          <!-- Body -->
          <tr>
            <td style="padding:40px 48px 32px;">
              <p style="margin:0 0 16px;color:#4a5568;font-size:15px;line-height:1.7;">Hi <strong>{{first_name}}</strong>,</p>
              <p style="margin:0 0 24px;color:#4a5568;font-size:15px;line-height:1.7;">
                We are pleased to inform you that your tenancy application for <strong>{{property_name}}</strong> has been reviewed and <strong style="color:#276749;">approved</strong>.
              </p>
              <p style="margin:0 0 24px;color:#4a5568;font-size:15px;line-height:1.7;">
                Our team will be in touch with you shortly to discuss the next steps, including lease agreements and move-in arrangements. Please ensure you are available and watch out for further communication from us.
              </p>
              <!-- Info box -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 28px;">
                <tr>
                  <td style="background:#ebf8ff;border-radius:8px;padding:16px 20px;border-left:4px solid #63b3ed;">
                    <p style="margin:0;color:#2b6cb0;font-size:14px;line-height:1.7;">
                      <strong>What happens next?</strong><br />
                      A member of our team will contact you to finalise your lease agreement and coordinate your move-in date. If you have any questions in the meantime, feel free to reply to this email.
                    </p>
                  </td>
                </tr>
              </table>
              <p style="margin:0;color:#718096;font-size:14px;line-height:1.7;">
                Thank you for choosing Frakensons Global. We look forward to welcoming you!
              </p>
            </td>
          </tr>
          <!-- Divider -->
          <tr>
            <td style="padding:0 48px;">
              <hr style="border:none;border-top:1px solid #e2e8f0;margin:0;" />
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="padding:24px 48px 40px;text-align:center;">
              <p style="margin:0;color:#a0aec0;font-size:12px;line-height:1.6;">
                &copy; {{year}} Frakensons Global Real Estate. All rights reserved.<br />
                <a href="https://fkglobalproperties.com" style="color:#a0aec0;text-decoration:underline;">fkglobalproperties.com</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
